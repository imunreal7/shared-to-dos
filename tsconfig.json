{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@common/*": ["packages/common/src/*"]
        },
        "module": "ESNext",
        "target": "ES2020",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "resolveJsonModule": true,
        "outDir": "dist"
    }
}

